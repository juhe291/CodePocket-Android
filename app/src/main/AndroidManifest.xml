<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="CodePocket"
        android:icon="@drawable/ic_app"
        android:roundIcon="@drawable/ic_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodePocket">
        <service android:name=".PythonExecutionService" android:exported="false" android:process=":python" />
        <service android:name=".PythonAnalysisService" android:exported="false" android:process=":analysis" />
        <service android:name=".CppAnalysisService" android:exported="false" android:process=":cpp_analysis" />
        <service android:name=".CppExecutionService" android:exported="false" android:process=":cpp_run" />
        <activity
            android:name=".MainActivity"
            android:resizeableActivity="true"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
