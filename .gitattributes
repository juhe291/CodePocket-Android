# Preserve offline grammar/notice/license bytes for the recorded SHA256 values.
editor-lab/src/main/assets/textmate/** -text whitespace=cr-at-eol
# Store upstream license spacing verbatim; keep normal checks on project code.
editor-lab/src/main/assets/textmate/licenses/** whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

# Preserve pinned terminal upstream bytes and original whitespace.
third-party/termux/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
app/src/main/assets/terminal-licenses/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

# Shared production editor assets retain the same upstream bytes after the move.
editor-sora/src/main/assets/textmate/** -text whitespace=cr-at-eol
editor-sora/src/main/assets/textmate/licenses/** whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

# Retain the original bytes/spacing of added upstream notices and raw tool diagnostics.
app/src/main/assets/cpp-licenses/CLANG-LICENSE.txt -text
app/src/main/assets/cpp-licenses/LLD-LICENSE.txt -text
app/src/main/assets/cpp-licenses/COMPILER-RT-LICENSE.txt -text
verification/cpp-local-integration-2026-10-27/*.log -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
# Exact generated snippets include deliberately indented blank tab stops.
verification/cpp-local-integration-2026-10-27/snippet-fixtures/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
verification/cpp-header-completion-2026-10-27/*.log -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
verification/cpp-header-completion-2026-10-27/snippet-fixtures/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
verification/settings-touch-fix-2026-10-28/*.log -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
