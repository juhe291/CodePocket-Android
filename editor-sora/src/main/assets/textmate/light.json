{
  "name": "CodePocket Light",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#263445",
    "editorCursor.foreground": "#000000",
    "editor.selectionBackground": "#ADD6FF",
    "editor.lineHighlightBackground": "#F3F3F3",
    "editorLineNumber.foreground": "#707070"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#7E4E94"
      }
    },
    {
      "scope": [
        "storage.type",
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#286B7D"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#795E26"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#8E4630"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#4F6F47"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#617667"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#315F79"
      }
    }
  ]
}