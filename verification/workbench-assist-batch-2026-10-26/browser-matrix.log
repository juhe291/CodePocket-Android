 check(await page.locator('.picker-empty').isVisible()&&await page.locator('.move-directories').evaluate(e=>e.clientHeight<150),'empty destination uses natural height');
 await page.locator('.move-directories .menurow').filter({hasText:'返回上一级'}).click();
 check((await page.locator('.move-target').innerText())==='目标：include'&&await codeElement.evaluate(e=>e===document.querySelector('#code')),'parent navigation preserves the editor example');
 await page.locator('#device').selectOption('tablet');await page.locator('#scene').selectOption('补全候选');
 check((await page.locator('.assist-preview .menu-heading-title').innerText())==='基础词法补全'&&await page.locator('.candidate-row small').count()===4,'candidate example labels its lexical scope and real kinds');
 await page.keyboard.press('ArrowDown');
 check(await page.locator('.candidate-row[aria-selected="true"]').getAttribute('data-candidate')==='1'&&(await page.locator('.candidate-detail').innerText()).includes('内置/常用名称'),'candidate arrows change the selected description');
 const originalCode=await page.locator('#code').elementHandle();await page.keyboard.press('Tab');
 check(await page.locator('.assist-preview').count()===0&&await originalCode.evaluate(e=>e===document.querySelector('#code')),'preview Tab closes without replacing the code element');
 await page.locator('#scene').selectOption('函数参数提示');
 check(await page.locator('[data-reference-next]').count()===0&&await page.locator('[data-reference-prev]').count()===0&&await page.locator('[data-close-assist]').isVisible(),'single reference keeps only a close action');
 await page.locator('#scene').selectOption('多形式参数参考');await page.locator('[data-reference-next]').click();
 check((await page.locator('.reference-code').innerText()).includes('step')&&(await page.locator('.assist-preview .menu-heading-title').innerText()).endsWith('2/2'),'multiple built-in forms remain navigable');
 check((await page.locator('.reference-notice').getAttribute('title')).includes('同名绑定未验证'),'reference retains its scope limitation');
 await page.evaluate(()=>selectFile('main.py'));await page.locator('#scene').selectOption('内置代码片段');
 check(await page.locator('.snippet-picker .choice-row').count()===6&&(await page.locator('.snippet-picker .picker-scope').innerText())==='Python · 内置模板','snippet preview uses one actual file language and six templates');
 await page.locator('.snippet-picker .choice-row').first().click();
 check(await page.locator('.snippet-picker').count()===0&&await originalCode.evaluate(e=>e===document.querySelector('#code')),'snippet design choice does not invent runtime output or replace the editor');
 await page.locator('#scene').selectOption('片段占位符导航');
 check(await page.locator('.snippet-picker .choice-row').count()===3&&(await page.locator('.snippet-picker').innerText()).includes('结束占位符导航'),'snippet touch navigation is a distinct preview state');
 return {cases,checks,paletteChecks,scenes:scenes.length,devices:devices.length,themes:2,errors,failures,androidDeviceVerified:false};
}
)(page);
